# 生产环境变量模板 —— 复制为 /opt/delivery-audit/.env 后按注释修改
# 注意：本文件仅为本项目生产部署提供，勿提交到公开仓库；权限设为 chmod 600

# ============================== 应用 ==============================
# 必须与最终访问地址完全一致（含 https，结尾不带斜杠）
APP_URL=https://delivery.example.com
# 会话密钥：至少 32 位随机串。生成命令 openssl rand -base64 48
# 生产模式（NODE_ENV=production + DEMO_MODE=false）下长度不足或使用占位值会直接启动失败
SESSION_SECRET=请替换为openssl-rand-base64-48生成的随机串
# 生产必须为 false；true 会在每次启动写入演示账号与演示单据
DEMO_MODE=false

# ============================== 数据 ==============================
# Compose 内置 PostgreSQL：postgresql://delivery:<POSTGRES_PASSWORD>@postgres:5432/delivery_audit
# 使用阿里云 RDS 时改为内网地址，且 ECS 与 RDS 需同地域同 VPC
DATABASE_URL=postgresql://delivery:请替换强密码@postgres:5432/delivery_audit
POSTGRES_PASSWORD=请替换强密码
# Compose 内置 Redis：redis://redis:6379
REDIS_URL=redis://redis:6379

# ============================== 识别 ==============================
# mock=不读取真实图片（仅演示，禁止用于验收）；aliyun=正式识别
OCR_MODE=aliyun
# 低于该置信度的字段必须人工确认（验收清单默认 0.90）
OCR_CONFIDENCE_THRESHOLD=0.90
# 百炼 DashScope（Qwen-VL 视觉结构化）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3.6-flash

# ============================== 存储 ==============================
# oss=阿里云对象存储（生产推荐）；local=容器卷 /app/.data/uploads（仅限试运行）
STORAGE_DRIVER=oss
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# OSS Bucket 必须私有；CORS：来源 https://<域名>，方法 PUT/GET，允许头 Content-Type

# ============================== 微信服务号 ==============================
# 未配置时仍可用员工号密码登录；正式上线需 ICP 备案域名 + HTTPS + 网页授权域名
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ============================== 业务阈值 ==============================
# 跨供应商比价高于近 30 天中位价 10% 提醒
CROSS_PRICE_TOLERANCE=0.10
# 同供应商同项目历史均价偏离 10% 提醒
HISTORY_PRICE_TOLERANCE=0.10
# 数量超过历史均值 2 倍提醒
QUANTITY_OUTLIER_MULTIPLIER=2
# 可比样本少于该数量时不判定异常
MIN_BENCHMARK_SAMPLES=3

# 日志目录由Compose固定为/app/.data/logs，并挂载持久卷。
LOG_ENABLED=true
LOG_SQL_MODE=all
LOG_MAX_FILE_MB=20
LOG_MAX_FILES=30
LOG_RETENTION_DAYS=14
LOG_SLOW_HTTP_MS=2000
LOG_SLOW_SQL_MS=500
RELEASE_ID=replace-with-release-tag
