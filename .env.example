# 应用
APP_URL=http://localhost:3000
SESSION_SECRET=请替换为至少32位随机字符串
DATABASE_URL=
REDIS_URL=
DEMO_MODE=true

# 识别：mock（本地演示）、aliyun（仅百炼 Qwen 视觉模型）
OCR_MODE=mock
OCR_CONFIDENCE_THRESHOLD=0.90
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3.6-flash

# 存储：local（本地演示）或 oss
STORAGE_DRIVER=local
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 微信认证服务号
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 业务阈值
CROSS_PRICE_TOLERANCE=0.10
HISTORY_PRICE_TOLERANCE=0.10
QUANTITY_OUTLIER_MULTIPLIER=2
MIN_BENCHMARK_SAMPLES=3

# 持久JSONL日志；HTTP+SQL默认全部记录，敏感字段与SQL参数值不保存。
APP_LOG_DIR=.data/logs
LOG_ENABLED=true
LOG_SQL_MODE=all
LOG_MAX_FILE_MB=20
LOG_MAX_FILES=30
LOG_RETENTION_DAYS=14
LOG_SLOW_HTTP_MS=2000
LOG_SLOW_SQL_MS=500
RELEASE_ID=local
