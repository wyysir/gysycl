{
  "name": "delivery-audit",
  "version": "1.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "description": "餐饮原材料送货单识别、智能建档与多项目比价系统",
  "scripts": {
    "dev": "node --require ./scripts/preload.cjs --import tsx scripts/server.ts --dev",
    "build": "next build",
    "start": "node --require ./scripts/preload.cjs --import tsx scripts/server.ts",
    "logs": "node --import tsx scripts/read-logs.ts",
    "worker": "node --require ./scripts/preload.cjs --import tsx scripts/worker.ts",
    "db:generate": "prisma generate",
    "db:reset": "node --require ./scripts/preload.cjs --import tsx scripts/reset-db.ts",
    "seed": "node --require ./scripts/preload.cjs --import tsx scripts/seed.ts",
    "seed:test-data": "node --require ./scripts/preload.cjs --import tsx scripts/seed-test-master-data.ts",
    "seed:test-purchases": "node --require ./scripts/preload.cjs --import tsx scripts/seed-test-purchases.ts",
    "create-admin": "node --require ./scripts/preload.cjs --import tsx scripts/create-admin.ts",
    "smoke": "node --require ./scripts/preload.cjs --import tsx scripts/smoke-test.ts",
    "visual-check": "node --require ./scripts/preload.cjs --import tsx scripts/visual-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ali-oss": "6.23.0",
    "bullmq": "6.3.17",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "ioredis": "^5.8.2",
    "jose": "6.2.12",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "opencc-js": "1.4.2",
    "pg": "^8.18.0",
    "pinyin-pro": "3.29.5",
    "prisma-pglite": "3.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.16.11",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright-core": "1.64.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.5"
  }
}
