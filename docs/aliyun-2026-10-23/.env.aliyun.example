# 两台ECS使用相同制品和相同业务配置 密钥只写入服务器不进入源码包
APP_IMAGE=delivery-audit:20261023-01
APP_ENV_FILE=/etc/delivery-audit/app.env
APP_URL=https://delivery.example.com
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
SESSION_SECRET=REPLACE_WITH_INDEPENDENT_64_HEX_RANDOM_SECRET
DEMO_MODE=false

# 用控制台实际私网域名和端口替换 URL中密码须编码 推荐使用随机十六进制密码
# 在/run/certs/rds-ca.pem放入实例控制台提供的有效CA
DATABASE_URL=postgresql://delivery_app:REPLACE_PASSWORD@REPLACE_RDS_PRIVATE_HOST:5432/delivery_audit?sslmode=verify-full&sslrootcert=/run/certs/rds-ca.pem
# Redis私网TLS端口以实例控制台为准 使用兼容Redis7的非分片标准架构
REDIS_URL=rediss://REPLACE_USER:REPLACE_PASSWORD@REPLACE_REDIS_PRIVATE_HOST:REPLACE_TLS_PORT
# 合并所需RDS和Redis受信任CA证书 确认证书域名及有效期
NODE_EXTRA_CA_CERTS=/run/certs/aliyun-ca-bundle.pem

OCR_MODE=aliyun
OCR_CONFIDENCE_THRESHOLD=0.90
ALIYUN_ACCESS_KEY_ID=REPLACE_OCR_RAM_KEY
ALIYUN_ACCESS_KEY_SECRET=REPLACE_OCR_RAM_SECRET
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
DASHSCOPE_API_KEY=REPLACE_DASHSCOPE_KEY
DASHSCOPE_BASE_URL=https://REPLACE_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 本部署候选模型 须先验证账号可用 多图JSON和真实单据 原业务默认未更改
QWEN_VL_MODEL=qwen3-vl-plus

STORAGE_DRIVER=oss
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=REPLACE_PRIVATE_BUCKET
# 浏览器需要直传 本版本不能把此处改成仅ECS可达的internal Endpoint
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=REPLACE_STORAGE_RAM_KEY
OSS_ACCESS_KEY_SECRET=REPLACE_STORAGE_RAM_SECRET

WECHAT_APP_ID=REPLACE_WECHAT_APP_ID
WECHAT_APP_SECRET=REPLACE_WECHAT_APP_SECRET
WECHAT_TEMPLATE_REVIEW_PENDING=REPLACE_PENDING_TEMPLATE_ID
WECHAT_TEMPLATE_REVIEW_RESULT=REPLACE_RESULT_TEMPLATE_ID

CROSS_PRICE_TOLERANCE=0.10
HISTORY_PRICE_TOLERANCE=0.10
QUANTITY_OUTLIER_MULTIPLIER=2
MIN_BENCHMARK_SAMPLES=3
